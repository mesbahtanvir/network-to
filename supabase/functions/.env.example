MATCHING_JOB_SECRET=replace-with-a-long-random-secret
HANDOFF_RATE_LIMIT_SALT=replace-with-a-separate-random-256-bit-secret
APPLE_APP_ID=replace-with-the-numeric-app-store-id
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
# Must equal the Vault secret named notification_job_secret.
NOTIFICATION_JOB_SECRET=replace-with-a-random-256-bit-secret
APNS_KEY_ID=replace-with-the-apns-authentication-key-id
APNS_TEAM_ID=replace-with-the-apple-developer-team-id
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
